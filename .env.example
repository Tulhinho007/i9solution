# URL de conexão PostgreSQL (Supabase / Neon) para ativar o Prisma ORM:
DATABASE_URL="postgresql://usuario:senha@host:5432/i9solution?schema=public"

# Senha forte para acesso ao Painel Administrativo (/admin) - Defina nas Environment Variables da Vercel:
ADMIN_PASSWORD="DefinaSuaSenhaForteAqui"

# Chave secreta para assinatura criptográfica HMAC-SHA256 dos cookies de sessão:
ADMIN_SESSION_SECRET="gere-uma-chave-aleatoria-longa-aqui"
